def view_students():
    cursor.execute("SELECT * FROM students")
    records = cursor.fetchall()

    print("\n" + "=" * 110)
    print(f"{'S.No':<8}{'Student Name':<20}{'Father Name':<20}"
          f"{'Gender':<10}{'PIN No':<18}{'Address':<16}{'Grade':<8}")
    print("=" * 110)

    for student in records:
        print(f"{student[0]:<8}{student[1]:<20}{student[2]:<20}"
              f"{student[3]:<10}{student[4]:<18}{student[5]:<16}{student[6]:<8}")

    print("=" * 110)


def search_student():
    sno = input("Enter Student S.No: ")

    cursor.execute("SELECT * FROM students WHERE sno = ?", (sno,))
    student = cursor.fetchone()

    if student:
        print("\nStudent Details")
        print("-" * 40)
        print("S.No         :", student[0])
        print("Student Name :", student[1])
        print("Father Name  :", student[2])
        print("Gender       :", student[3])
        print("PIN No       :", student[4])
        print("Address      :", student[5])
        print("Grade        :", student[6])
    else:
        print("Student not found!")


def add_student():
    print("\nEnter Student Details")

    sno = input("S.No: ")
    name = input("Student Name: ")
    father = input("Father Name: ")
    gender = input("Gender: ")
    pin = input("PIN No: ")
    address = input("Address: ")
    grade = input("Grade: ")

    try:
        cursor.execute("""
        INSERT INTO students
        (sno, student_name, father_name, gender, pin_no, address, grade)
        VALUES (?, ?, ?, ?, ?, ?, ?)
        """, (sno, name, father, gender, pin, address, grade))

        conn.commit()
        print("Student added successfully!")

    except sqlite3.IntegrityError:
        print("Error: Student S.No already exists.")


def update_student():
    sno = input("Enter Student S.No to update: ")

    cursor.execute("SELECT * FROM students WHERE sno = ?", (sno,))
    student = cursor.fetchone()

    if not student:
        print("Student not found!")
        return

    print("\nEnter new details")

    name = input("Student Name: ")
    father = input("Father Name: ")
    gender = input("Gender: ")
    pin = input("PIN No: ")
    address = input("Address: ")
    grade = input("Grade: ")

    cursor.execute("""
    UPDATE students
    SET student_name = ?,
        father_name = ?,
        gender = ?,
        pin_no = ?,
        address = ?,
        grade = ?
    WHERE sno = ?
    """, (name, father, gender, pin, address, grade, sno))

    conn.commit()
    print("Student updated successfully!")


def delete_student():
    sno = input("Enter Student S.No to delete: ")

    cursor.execute("SELECT * FROM students WHERE sno = ?", (sno,))
    student = cursor.fetchone()

    if student:
        cursor.execute("DELETE FROM students WHERE sno = ?", (sno,))
        conn.commit()
        print("Student deleted successfully!")
    else:
        print("Student not found!")


def search_by_grade():
    grade = input("Enter grade (A+, A, B+, B): ")

    cursor.execute(
        "SELECT * FROM students WHERE grade = ?",
        (grade,)
    )

    records = cursor.fetchall()

    if records:
        print("\nStudents with Grade", grade)
        print("-" * 60)

        for student in records:
            print(student[0], "-", student[1], "-", student[5], "-", student[6])
    else:
        print("No students found with this grade.")


